{
  "name": "spatial-ai-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "demo": "npm run build && npm start",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "smoke:ai": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/smoke.ts"
  },
  "dependencies": {
    "@playcanvas/supersplat-viewer": "1.42.1",
    "express": "^5.1.0",
    "playcanvas": "2.23.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
